---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Capsule from '../components/Capsule.astro';
import { SITE } from '../consts';
import { service } from '../lib/schema';

const alternates = [
  { lang: 'de-CH', href: `${SITE.url}/video/` },
  { lang: 'es', href: `${SITE.url}/es/video/` },
];
---
<BaseLayout
  title="Video & Videografie: Hochzeitsvideo & Eventvideo | Mariluz Fotografía"
  description="Videografie für Hochzeiten und Events in der Deutschschweiz. Foto und Video aus einer Hand, in einem Stil und mit einer Ansprechpartnerin."
  path="/video/"
  alternates={alternates}
  schema={service({ name: 'Videografie', description: 'Hochzeits- und Eventvideo in der Deutschschweiz.', serviceType: 'Videografie' })}
>
  <Hero eyebrow="Video" title="Bewegte Erinnerungen, Foto & Video aus einer Hand"
    lead="Ein Standbild hält den Blick fest, ein Film das Gefühl. Ich biete beides an, im gleichen Stil und ohne dass Sie zwei Teams koordinieren."
    ctaHref="/kontakt/" ctaLabel="Video anfragen" />
  <Capsule question="Warum Foto und Video bei einer Person?"
    answer="Weil Bildsprache, Farben und Stimmung dann zusammenpassen. Sie haben eine Ansprechpartnerin und nicht zwei Dienstleister, die sich am grossen Tag abstimmen müssen. So tragen die Fotos für die Wand und der Film zum Wiedererleben dieselbe Handschrift." />
  <!-- TODO: Video-Beispiele/Reel, Pakete -->
</BaseLayout>
