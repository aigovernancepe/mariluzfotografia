---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Capsule from '../components/Capsule.astro';
import { SITE } from '../consts';
import { service } from '../lib/schema';

const alternates = [
  { lang: 'de-CH', href: `${SITE.url}/schwangerschaftsfotos/` },
  { lang: 'es', href: `${SITE.url}/es/fotografo-embarazo/` },
];

// TODO Bilder: Es gibt bisher keine Schwangerschaftsaufnahmen aus der Schweiz.
// Der gesamte Bestand entstand in Peru und liegt unter schwangerschaft_es/,
// sichtbar auf /es/fotografo-embarazo/ und in beiden Portfolio-Übersichten.
// Sobald ein CH-Shooting da ist: assets/schwangerschaft_ch/ anlegen, hier auf
// HeroImage + Gallery umstellen (Muster siehe /hochzeitsfotograf/).
---
<BaseLayout
  title="Schwangerschaftsfotos: Babybauch-Shooting | Mariluz Fotografía"
  description="Schwangerschaftsfotos in der Deutschschweiz. Feinfühlige Babybauch-Shootings, die die Vorfreude festhalten, in Foto und Video, bei Ihnen zuhause oder in der Natur."
  path="/schwangerschaftsfotos/"
  alternates={alternates}
  schema={service({ name: 'Schwangerschaftsfotografie', description: 'Babybauch- und Schwangerschaftsfotos in der Deutschschweiz.', serviceType: 'Schwangerschaftsfotografie' })}
>
  <Hero
    eyebrow="Schwangerschaft"
    title="Schwangerschaftsfotos voller Vorfreude"
    lead="Diese besondere Zeit vergeht schnell. Ich halte sie feinfühlig und in Ruhe fest, für Erinnerungen, die bleiben."
    ctaHref="/kontakt/" ctaLabel="Termin anfragen" />

  <Capsule question="Wann ist der richtige Zeitpunkt für Schwangerschaftsfotos?"
    answer="Meist zwischen der 28. und 34. Schwangerschaftswoche. Dann ist der Bauch schön rund, und Sie fühlen sich noch beweglich. Wir planen den Termin entspannt, mit genug Zeit für Pausen. Ob Partner, Geschwister oder allein: Wir gestalten das Shooting so, wie es zu Ihnen passt." />

  <Capsule question="Wie läuft ein Babybauch-Shooting ab?"
    answer="Ganz in Ruhe und in Ihrem Tempo. Wir nehmen uns Zeit, damit Sie ankommen und sich wohlfühlen, und nichts wird gehetzt. Ich führe Sie behutsam durch sanfte, natürliche Posen, die den Bauch schön zur Geltung bringen, ohne gestellt zu wirken. Pausen gehören selbstverständlich dazu." />

  <section class="mx-auto max-w-3xl px-5 pt-8">
    <h2 class="text-2xl sm:text-3xl">Babybauch-Bilder aus echten Shootings</h2>
    <p class="prose-lead mt-4">Eine Auswahl aus über 20 Jahren Schwangerschaftsfotografie finden Sie im Portfolio.</p>
    <p class="mt-3"><a href="/portfolio/" class="text-sm font-medium text-[var(--color-clay)] hover:text-[var(--color-clay-dark)]">Babybauch-Bilder im Portfolio ansehen →</a></p>
  </section>

  <Capsule question="Wo entstehen die Bilder, und was ziehe ich an?"
    answer="Zuhause im vertrauten Licht, draussen in der Natur oder an einem Ort, der Ihnen etwas bedeutet. Sie entscheiden. Bei der Kleidung wirkt schlicht und figurbetont am schönsten. Bringen Sie gern zwei, drei Outfits mit, dann finden wir gemeinsam heraus, was zu Ihnen passt.">
    <!-- TODO: falls Fundus/Tücher vorhanden, hier konkret nennen -->
  </Capsule>

  <Capsule question="Können Partner und Geschwister dabei sein?"
    answer="Sehr gern. Schwangerschaft ist ein Familienmoment, und Ihr Partner und die grösseren Geschwister sind herzlich willkommen. Gemeinsame Aufnahmen, in denen sich alle auf das neue Familienmitglied freuen, gehören oft zu den berührendsten Bildern des Shootings. Sagen Sie einfach vorab Bescheid, wer dabei sein möchte." />

  <Capsule question="Geht Foto und Video zusammen?"
    answer="Ja, beides aus einer Hand. Auf Wunsch halte ich die Vorfreude auch als kurzes Video fest, ruhig und stimmungsvoll. Es bleibt bei einer Ansprechpartnerin und einem Stil. Die Standbilder hängen später an der Wand, der Film bleibt als bewegte Erinnerung an diese besondere Zeit.">
    <a href="/video/" class="text-sm font-medium text-[var(--color-clay)] hover:text-[var(--color-clay-dark)]">Mehr zu Video →</a>
  </Capsule>

  <Capsule question="Was kostet ein Schwangerschaftsshooting?"
    answer="Das richtet sich nach Dauer, Ort und danach, ob Sie nur Fotos oder auch Video möchten. Ich erstelle Ihnen ein individuelles Angebot, das zu Ihren Wünschen passt, und keine Pauschale. Fragen Sie unverbindlich an, am besten frühzeitig, damit wir den richtigen Zeitpunkt in Ruhe planen können.">
    <!-- TODO: konkrete Pakete/Preise nach Preis-Research + Mariluz-Input -->
    <a href="/kontakt/" class="inline-block rounded-full bg-[var(--color-clay)] px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-[var(--color-clay-dark)]">Termin anfragen</a>
  </Capsule>
</BaseLayout>
