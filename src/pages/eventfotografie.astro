---
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroImage from '../components/HeroImage.astro';
import Gallery from '../components/Gallery.astro';
import Capsule from '../components/Capsule.astro';
import { SITE } from '../consts';
import { service } from '../lib/schema';
import { toGallery } from '../lib/gallery';
import heroEvent from '../assets/event_ch/event_ch_002.jpg';

const alternates = [
  { lang: 'de-CH', href: `${SITE.url}/eventfotografie/` },
  { lang: 'es', href: `${SITE.url}/es/fotografo-eventos/` },
];

// Galerie wächst mit jedem neuen Bild in assets/event_ch/ — bis dahin bleibt der
// Abschnitt weg, statt mit einer fast leeren Reihe zu erscheinen.
const eventBilder = toGallery(
  import.meta.glob<{ default: ImageMetadata }>(
    '../assets/event_ch/*.{jpg,jpeg,png,webp,avif}',
    { eager: true },
  ),
  'Eventfotografie',
  ['event_ch_002'], // dient als Hero → nicht doppelt in der Galerie
);
---
<BaseLayout
  title="Eventfotograf für Feste & Anlässe | Mariluz Fotografía"
  description="Eventfotografie für Feste, Feiern und Anlässe in der Deutschschweiz. Foto und Video, die die Stimmung Ihres Events einfangen."
  path="/eventfotografie/"
  alternates={alternates}
  schema={service({ name: 'Eventfotografie', description: 'Foto und Video für Feste und Anlässe in der Deutschschweiz.', serviceType: 'Eventfotografie' })}
>
  <HeroImage
    image={heroEvent}
    alt="Kindergeburtstag im Garten: Mutter und zwei Mädchen hinter einer Geburtstagstorte, daneben Ballons und Dekoration. Foto von Mariluz Fotografía."
    focus="center 40%"
    eyebrow="Events & Feste"
    title="Eventfotografie mit Gespür für den Moment"
    lead="Ob Geburtstag, Jubiläum oder Familienfest: ich halte die Stimmung Ihres Anlasses fest, in Foto und Video."
    ctaHref="/kontakt/" ctaLabel="Event anfragen" />

  <Capsule question="Welche Events begleite ich?"
    answer="Private Feiern jeder Art: Geburtstage, Jubiläen, Taufen, Familienfeste und kulturelle Anlässe. Ich bewege mich unauffällig durch den Abend und fange echte Reaktionen ein, keine gestellten Gruppenbilder. Auf Wunsch Foto und Video aus einer Hand.">
    <a href="/taufe/" class="text-sm font-medium text-[var(--color-clay)] hover:text-[var(--color-clay-dark)]">Mehr zur Taufreportage →</a>
  </Capsule>

  <Capsule question="Wie arbeite ich an einem Event?"
    answer="Zurückhaltend und aufmerksam. Ich dränge mich nicht ins Geschehen, sondern lese den Abend mit: das Lachen, den Anstoss, den stillen Moment am Rand. So bleibt die Feier eine Feier, und die Bilder erzählen später, wie es wirklich war. Nach über 20 Jahren spüre ich, wann der Auslöser kommt." />

  {eventBilder.length > 0 && (
    <>
      <section class="mx-auto max-w-3xl px-5 pt-8">
        <h2 class="text-2xl sm:text-3xl">Bilder von echten Festen</h2>
        <p class="prose-lead mt-4">Eine Auswahl aus über 20 Jahren Feiern, von Kindergeburtstagen bis zu grossen Familienfesten. Die Galerie wächst mit jedem Anlass. Zum Vergrössern auf ein Bild tippen.</p>
      </section>
      <Gallery images={eventBilder} label="Eventfotografie von Mariluz Fotografía" />
    </>
  )}

  <Capsule question="Foto und Video für Ihren Anlass?"
    answer="Beides aus einer Hand. Neben den Fotos halte ich Ihr Event auf Wunsch als Video fest, mit der Musik, den Reden und der Bewegung des Abends. Sie müssen keine zwei Dienstleister koordinieren, sondern haben eine Ansprechpartnerin und einen Stil.">
    <a href="/video/" class="text-sm font-medium text-[var(--color-clay)] hover:text-[var(--color-clay-dark)]">Mehr zu Video →</a>
  </Capsule>

  <Capsule question="In welchen Regionen fotografiere ich Events?"
    answer="In der ganzen Deutschschweiz, mit Schwerpunkt Aargau, wo ich zuhause bin, und Basel. Als reisende Fotografin komme ich an Ihren Ort, ob Restaurant, Festsaal oder Garten. Weitere Regionen wie Zürich, Luzern und Solothurn gerne auf Anfrage." />

  <Capsule question="Was kostet ein Eventfotograf?"
    answer="Das hängt von Dauer, Anlass und davon ab, ob Sie Foto, Video oder beides möchten. Ich erstelle Ihnen ein individuelles Angebot, das zu Ihrem Fest passt, und keine Pauschale. Melden Sie sich mit Datum, Ort und ungefährer Dauer, dann melde ich mich zeitnah zurück.">
    <!-- TODO: konkrete Pakete/Preise nach Preis-Research + Mariluz-Input -->
    <!-- TODO: Firmenevents/Business-Fotografie verlinken sobald /business-fotografie/ gebaut -->
    <a href="/kontakt/" class="inline-block rounded-full bg-[var(--color-clay)] px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-[var(--color-clay-dark)]">Event anfragen</a>
  </Capsule>
</BaseLayout>
