---
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroImage from '../components/HeroImage.astro';
import Gallery from '../components/Gallery.astro';
import { SITE } from '../consts';
import { toGallery } from '../lib/gallery';
import heroPortfolio from '../assets/hochzeit_es/hochzeit_es_004.jpg';

const alternates = [
  { lang: 'de-CH', href: `${SITE.url}/portfolio/` },
  { lang: 'es', href: `${SITE.url}/es/galeria/` },
];

// Das Portfolio führt alles zusammen: pro Anlass die _ch- und _es-Ordner plus
// den gemeinsamen Altbestand. Die Service-Seiten zeigen nur ihre Sprachfassung,
// hier ist das Gesamtwerk zu sehen. Glob-Pfade müssen statische Literale sein.
const anlaesse = [
  {
    titel: 'Hochzeiten',
    bilder: toGallery(
      {
        ...import.meta.glob<{ default: ImageMetadata }>('../assets/hochzeit_ch/*.{jpg,jpeg,png,webp,avif}', { eager: true }),
        ...import.meta.glob<{ default: ImageMetadata }>('../assets/hochzeit_es/*.{jpg,jpeg,png,webp,avif}', { eager: true }),
      },
      'Hochzeitsfotografie',
      ['hochzeit_es_004'], // dient als Hero → nicht doppelt in der Galerie
    ),
  },
  {
    titel: 'Familien & Kinder',
    bilder: toGallery(
      {
        ...import.meta.glob<{ default: ImageMetadata }>('../assets/familie_ch/*.{jpg,jpeg,png,webp,avif}', { eager: true }),
        ...import.meta.glob<{ default: ImageMetadata }>('../assets/familie_es/*.{jpg,jpeg,png,webp,avif}', { eager: true }),
      },
      'Familienfotografie',
    ),
  },
  {
    titel: 'Schwangerschaft',
    bilder: toGallery(
      import.meta.glob<{ default: ImageMetadata }>('../assets/schwangerschaft_es/*.{jpg,jpeg,png,webp,avif}', { eager: true }),
      'Schwangerschaftsfotografie',
    ),
  },
  {
    titel: 'Babys',
    bilder: toGallery(
      import.meta.glob<{ default: ImageMetadata }>('../assets/baby_es/*.{jpg,jpeg,png,webp,avif}', { eager: true }),
      'Babyfotografie',
    ),
  },
  {
    titel: 'Quinceañera',
    bilder: toGallery(
      import.meta.glob<{ default: ImageMetadata }>('../assets/quinceanera_es/*.{jpg,jpeg,png,webp,avif}', { eager: true }),
      'Quinceañera-Fotografie',
    ),
  },
  {
    titel: 'Events & Feste',
    bilder: toGallery(
      {
        ...import.meta.glob<{ default: ImageMetadata }>('../assets/event_ch/*.{jpg,jpeg,png,webp,avif}', { eager: true }),
        ...import.meta.glob<{ default: ImageMetadata }>('../assets/event_es/*.{jpg,jpeg,png,webp,avif}', { eager: true }),
      },
      'Eventfotografie',
    ),
  },
].filter((a) => a.bilder.length > 0);
---
<BaseLayout
  title="Portfolio für Foto & Video | Mariluz Fotografía"
  description="Eine Auswahl aus Hochzeiten, Quinceañeras, Familien-, Schwangerschafts- und Eventaufnahmen von Mariluz Fotografía aus der Deutschschweiz und Peru."
  path="/portfolio/"
  alternates={alternates}
>
  <HeroImage
    image={heroPortfolio}
    alt="Brautpaar springt vor Freude an einem Strand, im Hintergrund Klippen und Meer; sie im weissen Kleid mit Blumenkranz. Foto von Mariluz Fotografía."
    eyebrow="Portfolio"
    title="Eine Auswahl meiner Arbeiten"
    lead="Bilder sagen mehr als Worte. Hier eine Auswahl aus echten Feiern: Hochzeiten, Familien, Schwangerschaft, Quinceañeras und Feste aus der Deutschschweiz und Peru."
    ctaHref="/kontakt/"
    ctaLabel="Termin anfragen"
  />

  <section class="mx-auto max-w-3xl px-5 pt-10">
    {/* TODO Herkunft bestätigen: „Lateinamerika" ist Annahme — ggf. konkretes Land (z. B. Peru) einsetzen. */}
    <p class="prose-lead">Eine Auswahl aus über 20 Jahren, von meinen Anfängen in Lateinamerika bis heute in der Deutschschweiz. Hochzeiten, Quinceañeras, Familien- und Schwangerschaftsaufnahmen sowie Feste und Anlässe. Die Galerie wächst mit jeder Feier. Bilder werden nur nach Einwilligung der Abgebildeten veröffentlicht. Zum Vergrössern auf ein Bild tippen.</p>
  </section>

  {anlaesse.map((a) => (
    <>
      <section class="mx-auto max-w-5xl px-5 pt-8">
        <h2 class="text-2xl sm:text-3xl">{a.titel}</h2>
      </section>
      <Gallery images={a.bilder} label={`${a.titel} | Mariluz Fotografía`} />
    </>
  ))}
</BaseLayout>
