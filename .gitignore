# build output
dist/
.output/
.vercel/
.netlify/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.*
!.env.example

# astro
.astro/

# Foto-Pool: Bilder standardmässig NICHT committen (lokaler Kuratier-Pool).
# Nur tatsächlich auf der Site verwendete Bilder per "!" freigeben (git add -f nötig).
src/assets/_unsortiert/
src/assets/**/*.jpg
src/assets/**/*.jpeg
src/assets/**/*.png
!src/assets/about/mariluz-kamera.jpg
!src/assets/brand/sobre_mi_1.jpeg
# Markenlogo: logo-mariluz = volles Lockup (Footer), logo-mark = Medaillon
# (Kopfleiste + Favicon-Quelle). Beide aus der Originaldatei ohne URL-Zeile.
!src/assets/brand/logo-mariluz.png
!src/assets/brand/logo-mark.png

# Auf der Site verwendete Bilder freigeben (direkte Heroes + Glob-Galerien).
# Konvention: <anlass>_<sprache>/<anlass>_<sprache>_NNN.jpg. Das Suffix sagt,
# welche Sprachfassung die Bilder nutzt, und folgt der Herkunft: _ch für die
# Schweizer Aufnahmen, _es für die aus Peru. Suffixlose Ordner gibt es nicht
# mehr. Die Portfolio-Seiten (/portfolio/ und /es/galeria/) führen alles zusammen.
# Dreistellig nummerieren, sonst sortieren die Galerien falsch (Pfad-Sortierung).
!src/assets/hochzeit_ch/**
!src/assets/hochzeit_es/**
!src/assets/familie_ch/**
!src/assets/familie_es/**
!src/assets/event_ch/**
!src/assets/event_es/**
!src/assets/baby_es/**
!src/assets/taufe_es/**
!src/assets/quinceanera_es/**
!src/assets/schwangerschaft_es/**

# macOS
.DS_Store

# editors
.vscode/
.idea/

# cloudflare
.wrangler/
